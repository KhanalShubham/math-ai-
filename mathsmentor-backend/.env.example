# Copy to .env for local development. Never commit .env.
# All of these are read exclusively by src/config/env.ts — see ARCHITECTURE.md §9/§10.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database ---
MONGO_URI=mongodb://localhost:27017/mathsmentor

# --- Redis (cache, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI provider abstraction (ARCHITECTURE.md §14) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- File storage (ARCHITECTURE.md §15) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
